# Optional Aliyun candidate only. This file neither selects a supplier nor sends SMS.
# Copy into a PRIVATE file such as var/private/sms.env; never fill this example.
# Check offline with: node --env-file=var/private/sms.env scripts/sms-check.mjs
# A passing check only confirms configuration shape, not account access, approval or delivery.
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
# Optional temporary credential; keep blank when using a long-term RAM credential.
SMS_SECURITY_TOKEN=
