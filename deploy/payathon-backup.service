[Unit]
Description=Consistent Payathon test backup with isolated restore verification
After=payathon-test.service

[Service]
Type=oneshot
User=payathon-test
Group=payathon-test
WorkingDirectory=/opt/payathon-ops/current
EnvironmentFile=/etc/payathon-test/app.env
Environment=BACKUP_ROOT=/var/backups/payathon-test
Environment=BACKUP_CONFIG_DIRECTORY=/etc/payathon-test
Environment=APP_RELEASE=/opt/payathon-test/current
ExecStart=/opt/payathon-tools/node-v24.19.0-linux-x64/bin/node scripts/backup.mjs create
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/payathon-test

