# Public HTTPS phone-login trial, using a separate database; body data stays synthetic.
# Credentials are loaded separately from /etc/payathon-test/sms-auth.env, never archived.
APP_MODE=sms-trial
HOST=127.0.0.1
PORT=4181
PUBLIC_ORIGIN=https://101.132.150.197
DATABASE_PATH=/var/lib/payathon-test/phone-trial.sqlite
SMS_MODE=provider
SMS_PROVIDER=aliyun-pnvs
# Counts all dispatch attempts, including failed/unknown outcomes, per Beijing day.
SMS_DAILY_LIMIT=10
