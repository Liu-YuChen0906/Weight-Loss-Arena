# Aliyun phone verification (PNVS) SMS authentication; separate from ordinary SMS.
# Store actual values only in var/private/sms-auth.env or a private server env file.
# Offline check: node --env-file=var/private/sms-auth.env scripts/sms-check.mjs
# Loading this file alone does not enable a service or send SMS.
SMS_PROVIDER=aliyun-pnvs
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=恒创联众
SMS_TEMPLATE_CODE=100001
# Optional STS token; leave blank for a permanent RAM AccessKey.
SMS_SECURITY_TOKEN=
