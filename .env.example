# Local development only. No real SMS is sent by the development adapter.
HOST=127.0.0.1
PORT=4180
DATABASE_PATH=./var/development.sqlite
SMS_MODE=development
# Production/public trial is intentionally gated until policies and SMS are ready.
# Optional independent deletion journal (default: DATABASE_PATH.deletions.sqlite).
# Preserve it separately from snapshots; recovery must use its latest copy.
# DELETION_JOURNAL_PATH=/private/path/deletions.sqlite
# Optional Aliyun adapter configuration; NOT enabled by local/test startup.
# SMS_PROVIDER=aliyun
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=
# SMS_SECURITY_TOKEN=
