{
  "name": "shangcheng-workspace",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "format": "prettier --write \"apps/**/*.{java,vue,ts,css,html,json,yml}\" \"scripts/**/*.mjs\" \"deploy/**/*.yml\" \".github/**/*.yml\" package.json",
    "format:check": "prettier --check \"apps/**/*.{java,vue,ts,css,html,json,yml}\" \"scripts/**/*.mjs\" \"deploy/**/*.yml\" \".github/**/*.yml\" package.json"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "prettier-plugin-java": "2.7.1"
  }
}
